PORT=3000
NODE_ENV=development

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=adidas_shop

JWT_SECRET=
JWT_EXPIRES_IN=7d
CORS_ORIGINS=*

# VNPay sandbox only. Keep the hash secret on the backend.
VNPAY_TMN_CODE=YOUR_VNPAY_TMN_CODE
VNPAY_HASH_SECRET=YOUR_VNPAY_SANDBOX_HASH_SECRET
VNPAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=https://your-public-domain.example/api/v1/payments/vnpay/return
# Configure this same public URL as the IPN endpoint in the VNPay merchant portal.
VNPAY_IPN_URL=https://your-public-domain.example/api/v1/payments/vnpay/ipn
